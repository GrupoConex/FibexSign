{
  "name": "opensign",
  "version": "1.0.6",
  "description": "Free and open source alternative to DocuSign",
  "main": "index.js",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "turbo dev --ui=tui",
    "dev:frontend": "pnpm --filter open_sign dev",
    "dev:backend": "pnpm --filter open_sign_server dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "prepare": "husky install",
    "lint-staged-changes": "lint-staged"
  },
  "repository": {
    "type": "git",
    "url": "github.com/opensignlabs/opensign"
  },
  "keywords": [
    "digital",
    "signature",
    "e-signature",
    "docusign",
    "electronic",
    "signature"
  ],
  "author": "OpenSignLabs",
  "license": "AGPL-3.0",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "turbo": "^2.10.13"
  }
}
